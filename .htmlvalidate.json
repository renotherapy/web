{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": ["error", { "style": "double" }],
    "heading-level": "off",
    "long-title": "off",
    "no-inline-style": "off",
    "no-raw-characters": "off",
    "prefer-native-element": "off",
    "valid-id": ["error", { "relaxed": true }]
  }
}
